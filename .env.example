# Copy this file to .env or export the variables in your shell before running.

# Spring Boot backend
DB_URL=jdbc:mysql://localhost:3306/mydb?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=123456
JPA_SHOW_SQL=false
RAG_SERVICE_URL=http://127.0.0.1:5000

# Optional Coze workflow integration
COZE_TOKEN=
COZE_WORKFLOW_ID=

# Python RAG service
RAG_MODEL_PATH=sentence-transformers/all-MiniLM-L6-v2
RAG_DB_URL=mysql+pymysql://root:123456@localhost/mydb
RAG_INDEX_FILE=news_index.faiss
RAG_DATA_FILE=news_data.pkl
RAG_HOST=0.0.0.0
RAG_PORT=5000
RAG_BATCH_SIZE=32
RAG_MODEL_DIR=./all-MiniLM-L6-v2
RAG_DATA_DIR=./rag-data
RAG_CONTAINER_MODEL_PATH=/models/all-MiniLM-L6-v2
RAG_CONTAINER_DB_URL=mysql+pymysql://root:123456@mysql8/mydb
RAG_CONTAINER_INDEX_FILE=/data/news_index.faiss
RAG_CONTAINER_DATA_FILE=/data/news_data.pkl

# News fetch job
JUHE_APPKEY=
NEWS_TYPE=guonei
NEWS_OUTPUT_DIR=news_data

# Spark jobs
NEWS_RAW_DIR=hdfs://namenode:8020/news/raw/*.json
NEWS_PROCESSED_DIR=hdfs://namenode:8020/news/processed
NEWS_ANALYSIS_INPUT=hdfs://namenode:8020/news/processed
NEWS_ANALYSIS_FORMAT=parquet
NEWS_MYSQL_INPUT=hdfs://namenode:8020/news/raw/news_data.json
HDFS_DEFAULT_FS=hdfs://namenode:8020
SPARK_MYSQL_URL=jdbc:mysql://mysql8:3306/mydb?useSSL=false&allowPublicKeyRetrieval=true
SPARK_MYSQL_TABLE=news
SPARK_MYSQL_USER=root
SPARK_MYSQL_PASSWORD=123456
SPARK_MYSQL_DRIVER=com.mysql.cj.jdbc.Driver
SPARK_MYSQL_JAR=/opt/spark/jars/mysql-connector-java-8.0.29.jar
SPARK_SHUFFLE_PARTITIONS=4
SPARK_WRITE_MODE=overwrite
